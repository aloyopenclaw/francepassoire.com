// workers/social/wrangler.jsonc — worker de publication sociale (T38–T40 + T51, Wave 5).
//
// Modèle « file d'attente » (docs/social-setup.md, § Principe) : les posts
// s'accumulent dans D1 (social_outbox) et partent dès que la clé de la
// plateforme concernée existe comme secret. Le lancement du site n'attend
// aucune de ces clés — les lignes sans clé passent PENDING_KEYS, jamais en
// échec.
//
// Comme le worker d'ingestion, ce worker possède sa propre config (le
// wrangler.toml racine reste minimal, périmètre D1). Il pointe la MÊME base
// D1 de staging (database_id n'est pas un secret : identifiant, pas un jeton).

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "francepassoire-social",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "observability": { "enabled": true },

  // Cron toutes les 5 minutes : vidage de la file social_outbox
  // (PENDING → envoi ; PENDING_KEYS → re-test des secrets ; le cron
  // lui-même sert de pacing naturel entre deux tentatives).
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // Staging D1 (migrations partagées avec la racine, d'où le ../../migrations).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "francepassoire",
      "database_id": "613f348d-fb59-478c-8f53-84a8679f1ed9",
      "migrations_dir": "../../migrations"
    }
  ]

  // SECRETS (PAS des vars — jamais de valeur en clair ici). Noms canoniques
  // alignés sur docs/social-setup.md (« Secrets wrangler canoniques ») :
  //
  //   npx wrangler secret put X_BEARER
  //     Bearer token app-only X — LECTURE SEULE, ce worker ne l'utilise
  //     JAMAIS pour publier (docs/social-setup.md §1 : le Bearer ne peut pas
  //     poster ; il figure ici pour mémoire, consommation future en lecture).
  //
  //   npx wrangler secret put MAKE_WEBHOOK_URL
  //     URL du webhook Make.com — chemin de production pour X (module
  //     « Create a Post » OAuth'é @francepassoire) ET LinkedIn page.
  //     L'URL longue EST le crédential : qui la possède déclenche le post.
  //
  //   npx wrangler secret put LINKEDIN_ACCESS_TOKEN
  //     Token membre (scope w_member_social, durée de vie 60 jours —
  //     renouvellement à ~2 mois, le worker logue l'échec d'expiration).
  //     NB : le chemin PRODUCTION LinkedIn est le webhook Make ci-dessus ;
  //     ce token ne sert qu'au client direct de référence.
  //
  //   npx wrangler secret put LINKEDIN_MEMBER_URN
  //     URN du membre émetteur, ex. urn:li:person:XXXXXX — copiée depuis la
  //     page Token Generator du portail développeur LinkedIn (secret
  //     additionnel documenté par la T40 : le token seul ne suffit pas,
  //     l'UGC Post exige l'auteur).
  //
  //   (Les secrets Facebook Page et Instagram n'existent plus : plateformes
  //   retirées le 23/08 — décision propriétaire, plus de produits Meta ;
  //   les clients correspondants ont été supprimés du worker.)
  //
  // Aucun secret n'existe au jour du lancement : le worker tourne quand
  // même (cron) et les lignes s'accumulent en PENDING_KEYS. Le déploiement
  // live sera déclenché au câblage des clés — d'où le dry-run seul en QA.
}
