// workers/email-probe/wrangler.jsonc — sonde pré-vol send_email (T29, Wave 4).
//
// BUT (docs/email-infra.md § Pré-vol) : vérifier PAR L'EXPÉRIENCE la
// contrainte historique du binding send_email — envoi UNIQUEMENT vers une
// destination vérifiée Email Routing. Ce worker est une sonde jetable :
// un GET déclenche un unique envoi de test et retourne le verdict JSON du
// binding. Il ne fait rien d'autre (aucune D1, aucun cron, aucune autre
// route) et ne sera jamais importé par le reste du dépôt.
//
// Comme les workers api/ingest/social : config propre (le wrangler.toml
// racine reste minimal, périmètre D1).
//
// destination_address = contact@francepassoire.com : c'est LA question que
// la sonde pose — cette adresse est une adresse personnalisée du domaine
// (pas une destination vérifiée, aucune n'existe au jour de la T29). Le
// déploiement lui-même est donc partie du test : si wrangler refuse au
// moment du deploy, la contrainte est confirmée au niveau build ; s'il
// accepte, c'est l'appel .send() au runtime qui tranche.

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "francepassoire-email-probe",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "observability": { "enabled": true },

  "send_email": [
    {
      "name": "SEND_EMAIL",
      "destination_address": "contact@francepassoire.com"
    }
  ]
}
