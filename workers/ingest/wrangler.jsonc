// workers/ingest/wrangler.jsonc — configuration propre au worker d'ingestion (T13).
// Le wrangler.toml racine reste volontairement minimal (périmètre D1, tâche 7) :
// ce worker possède sa propre config, comme anticipé dans son en-tête.
// database_id n'est pas un secret (identifiant, pas un jeton).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "francepassoire-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "observability": { "enabled": true },

  // Cron toutes les 15 minutes : fetch → normalize → candidates (status NEW).
  "triggers": {
    "crons": ["7,37 * * * *"]
  },

  // Staging D1 (migrations partagées avec la racine, d'où le ../../migrations).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "francepassoire",
      "database_id": "613f348d-fb59-478c-8f53-84a8679f1ed9",
      "migrations_dir": "../../migrations"
    }
  ],

  // État de run par source (last_run, last_success, guid_set, circuit breaker).
  // Id réel du namespace « francepassoire-ingest-runstate » créé le 2026-08-20
  // (tâche 20) : `npx wrangler kv namespace create francepassoire-ingest-runstate`.
  "kv_namespaces": [
    {
      "binding": "RUN_STATE",
      "id": "3ce5bafcbfa8405faa32898ab7769c49"
    }
  ]

  // SECRETS (PAS des vars — jamais de valeur en clair ici) :
  //   RANSOMWARE_LIVE_API_KEY — clé de l'API PRO ransomware.live (T54b :
  //                             api-pro.ransomware.live/victims/recent,
  //                             en-tête X-API-KEY). PREMIER secret du worker
  //                             ingest. Clé maître quarantinée hors dépôt :
  //                             ~/.config/francepassoire/ransomware-live.token
  //                             npx wrangler secret put RANSOMWARE_LIVE_API_KEY --config workers/ingest/wrangler.jsonc
  //                             Sans la clé : la source est ignorée avec un
  //                             log fort (config, pas un jour calme), aucun
  //                             fetch, last_success vieillit — signal honnête
  //                             du rapport quotidien workers/api.
  //   FRANCEPASSOIRE_GH_TOKEN — fine-grained PAT, contenu+PR du dépôt, pour
  //                             l'ouverture des PR de la file de validation
  //                             (src/pr-automation.ts, T19) :
  //                             npx wrangler secret put FRANCEPASSOIRE_GH_TOKEN
  //                             Le jeton réel n'existe pas encore : les tests
  //                             T19 injectent un fake.
}
