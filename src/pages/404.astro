---
// src/pages/404.astro — page d'erreur 404 (T50). Astro statique émet
// /404.html, servi automatiquement par Cloudflare Pages pour tout chemin
// manquant. Même contrat visuel que le hero d'accueil (index.html figé) :
// tuile crème emboutie, ombre dure, bouton à enfoncement — Ton A sobre.
// noindex : une page d'erreur ne doit pas polluer l'index (slot head du
// Layout, qui ne propose pas encore de prop dédiée).
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Page introuvable - France Passoire"
  description="Cette page n'existe pas — ou plus. Retour à l'accueil de FrancePassoire."
  canonical="/"
>
  <meta name="robots" content="noindex" slot="head" />

  <section class="bg-dot-matrix border-b-2 border-brand-ink py-16 sm:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 flex flex-col items-center text-center gap-8">

      <p class="font-mono text-sm bg-brand-ink text-brand-cream border-2 border-brand-ink rounded-passoire px-4 py-1 shadow-hard-sm">
        Erreur 404
      </p>

      <h1 class="font-display font-extrabold text-4xl sm:text-6xl bg-brand-cream border-2 border-brand-ink shadow-hard rounded-passoire p-6 sm:p-10 transform -rotate-1">
        Page introuvable.
      </h1>

      <p class="font-body text-lg sm:text-xl leading-relaxed max-w-xl">
        Cette page n'existe pas — ou plus.
      </p>

      <div class="flex flex-col sm:flex-row justify-center items-center gap-6">
        <a href="/" class="bg-brand-orange text-brand-ink px-6 py-3 rounded-passoire border-2 border-brand-ink shadow-hard hover:bg-brand-hover btn-press transition-all font-display font-bold text-lg flex items-center gap-2">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="svg-ink"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
          Retour à l'accueil
        </a>
      </div>
    </div>
  </section>
</Layout>
