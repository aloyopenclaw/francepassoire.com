---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { composerDossiers, formaterDate } from '../../lib/group-view';

// Cartes « Groupes actifs » : dérivées du catalogue (fiches avec `group`),
// triées par nombre de victimes françaises puis date de dernière revendication.
const dossiers = (await getCollection('catalog')).map((entry) => entry.data);
const groupesActifs = composerDossiers(dossiers).sort(
  (a, b) =>
    b.fiches.length - a.fiches.length ||
    b.fiches[0].dates.revendication.localeCompare(a.fiches[0].dates.revendication),
);
const maintenant = Date.now();
const IL_Y_A_7_JOURS = 7 * 24 * 3600 * 1000;
const dernieres7j = dossiers
  .filter(
    (fiche) =>
      fiche.group &&
      maintenant - Date.parse(`${fiche.dates.revendication}T00:00:00Z`) <= IL_Y_A_7_JOURS,
  )
  .sort((a, b) => b.dates.revendication.localeCompare(a.dates.revendication));
---
<Layout
  title="Ransomware - France Passoire"
  description="Le panorama des revendications ransomware touchant la France — tableau des 7 derniers jours, groupes actifs et règle de publication."
>
  <!-- Hero -->
  <section class="bg-dot-matrix border-b-2 border-brand-ink py-16 sm:py-24 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 flex flex-col items-center text-center">
      <div class="bg-brand-cream border-2 border-brand-ink shadow-hard rounded-passoire p-6 sm:p-10 mb-4 transform rotate-1">
        <h1 class="font-display font-extrabold text-4xl sm:text-6xl mb-4">
          Ransomware — les revendications,<br>en direct.
        </h1>
        <p class="font-mono text-lg max-w-2xl mx-auto font-bold opacity-90">
          Quand un groupe publie une liste de victimes françaises, la fiche apparaît ici.
        </p>
      </div>
    </div>
  </section>

  <section class="py-12 bg-brand-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">

      <!-- 7 derniers jours : lignes dérivées du catalogue (fiches groupées ≤ 7 j) -->
      <div>
        <h2 class="font-display font-extrabold text-2xl mb-6">7 derniers jours</h2>
        <div class="bg-brand-cream border-2 border-brand-ink rounded-passoire shadow-hard overflow-x-auto">
          <table class="w-full text-left border-collapse font-mono text-sm min-w-[700px]">
            <thead>
              <tr class="border-b-2 border-brand-ink bg-brand-paper">
                <th class="p-4 font-bold">Date</th>
                <th class="p-4 font-bold">Groupe</th>
                <th class="p-4 font-bold">Victime</th>
                <th class="p-4 font-bold">Secteur</th>
                <th class="p-4 font-bold">Détails</th>
                <th class="p-4 font-bold text-right">Statut</th>
              </tr>
            </thead>
            <tbody>
              {dernieres7j.length === 0 ? (
                <tr>
                  <td colspan="6" class="p-8 text-center font-body text-base text-brand-ink/70 leading-relaxed">
                    Aucune revendication vérifiée sur les 7 derniers jours — le tableau se
                    remplit dès la première entrée passée par notre méthode de vérification.
                  </td>
                </tr>
              ) : (
                dernieres7j.map((fiche) => (
                  <tr class="border-b border-brand-ink/10">
                    <td class="p-4">{formaterDate(fiche.dates.revendication)}</td>
                    <td class="p-4">
                      <a href={`/ransomware/${fiche.group ? fiche.group.trim().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-') : ''}/`} class="underline decoration-2 hover:text-brand-orange">{fiche.group}</a>
                    </td>
                    <td class="p-4">
                      <a href={`/fiche/${fiche.slug}/`} class="underline decoration-2 hover:text-brand-orange">{fiche.entity}</a>
                    </td>
                    <td class="p-4">{fiche.secteur}</td>
                    <td class="p-4">{fiche.volume.label.slice(0, 48)}</td>
                    <td class="p-4 text-right">
                      <span class={fiche.statut === 'confirmee' ? 'pill-confirmee inline-block' : 'pill-revendiquee inline-block'}>{fiche.statut === 'confirmee' ? 'Confirmée' : 'Revendiquée'}</span>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Groupes actifs : cartes dérivées du catalogue, lien vers chaque dossier -->
      <div>
        <h2 class="font-display font-extrabold text-2xl mb-6">Groupes actifs</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {groupesActifs.slice(0, 8).map((dossier) => (
            <a href={`/ransomware/${dossier.slug}/`} class="bg-brand-cream border-2 border-brand-ink rounded-xl p-5 shadow-[4px_4px_0px_0px_#241405] hover:-translate-y-1 hover:shadow-[6px_6px_0px_0px_#241405] transition-all text-left">
              <div class="flex justify-between items-start mb-4">
                <span class="font-display font-black text-xl">{dossier.nom}</span>
              </div>
              <p class="font-mono text-sm mb-1">
                <strong class="text-brand-orange text-lg">{dossier.fiches.length}</strong>
                {dossier.fiches.length > 1 ? 'victimes FR recensées' : 'victime FR recensée'}
              </p>
              <p class="font-mono text-xs opacity-70">Dernière : {formaterDate(dossier.fiches[0].dates.revendication)}</p>
            </a>
          ))}
        </div>
        {groupesActifs.length > 8 && (
          <p class="font-mono text-sm mt-4 text-brand-ink/70">
            + {groupesActifs.length - 8} autre{groupesActifs.length - 8 > 1 ? 's' : ''} groupe{groupesActifs.length - 8 > 1 ? 's' : ''} documenté{groupesActifs.length - 8 > 1 ? 's' : ''} — voir les dossiers complets sur chaque fiche.
          </p>
        )}
      </div>

      <!-- Posture éditoriale -->
      <div class="bg-brand-ink text-brand-cream p-6 rounded-passoire border-2 border-brand-ink shadow-hard mt-12">
        <p class="font-mono text-sm text-center leading-relaxed">
          <strong class="font-display text-lg tracking-wide uppercase block mb-1">Règle de publication</strong>
          Nous documentons les revendications publiques. Nous ne consultons ni ne reproduisons aucune donnée volée. Les groupes de ransomware ne sont pas des hacktivistes, ce sont des organisations criminelles à but lucratif.
        </p>
      </div>

    </div>
  </section>
</Layout>
