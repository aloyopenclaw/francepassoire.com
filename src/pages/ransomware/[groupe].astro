---
import Layout from '../../layouts/Layout.astro';

// Wave 0 : aucun dossier de groupe publié — aucune page n'est générée.
export function getStaticPaths() {
  return [];
}

const { groupe } = Astro.params;
---
<Layout title="Dossier de groupe - France Passoire">
  <section class="py-16 bg-brand-paper">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h1 class="font-display font-extrabold text-4xl sm:text-5xl mb-4">{groupe ? `Dossier « ${groupe} »` : 'Dossier de groupe'}</h1>
      <p class="font-body text-lg text-brand-ink/70 leading-relaxed mb-8">
        Ce dossier n'est pas encore publié : les profils de groupes arrivent
        au fil des revendications vérifiées, jamais avant.
      </p>
      <a href="/ransomware/" class="font-display font-bold flex items-center gap-2 hover:text-brand-orange transition-colors w-max">
        <svg width="20" height="20" viewBox="0 0 24 24" class="svg-ink"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Retour au panorama
      </a>
    </div>
  </section>
</Layout>
