---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Ticker from '../components/Ticker.astro';
import CatalogFilters, { type LeakCard } from '../components/CatalogFilters.astro';
import type { TickerItem } from '../components/Ticker.astro';
import {
  classeStatut,
  dateAttribution,
  formaterDate,
  formaterNombre,
  labelSecteur,
  labelStatut,
  urlFiche,
} from '../lib/hub-view';
import { computeCompteur, type FicheLike } from '../lib/stats';

// Catalogue réel : toutes les fiches publiées, les plus récentes d'abord
// (attribution desc, puis slug asc — même ordre déterministe que les hubs).
const fiches = (await getCollection('catalog'))
  .map((entry) => entry.data)
  .sort(
    (a, b) =>
      dateAttribution(b).localeCompare(dateAttribution(a)) ||
      a.slug.localeCompare(b.slug),
  );

const compteur = computeCompteur(fiches);

/** Volume court pour ticker et cartes : « 162 437 enregistrements », ou
 *  « volume non chiffré » quand aucun chiffre n'est annoncé (count = 0). */
function volumeCourt(volume: FicheLike['volume']): string {
  return volume.count > 0
    ? `${formaterNombre(volume.count)} ${volume.unit}`
    : 'volume non chiffré';
}

// Ticker : les 8 dernières fuites, chaque item pointe vers la fiche publiée.
const tickerItems: TickerItem[] = fiches.slice(0, 8).map((fiche) => ({
  label: `${fiche.entity} — ${volumeCourt(fiche.volume)}`,
  url: urlFiche(fiche.slug),
}));

// Cartes du catalogue : view models sérialisés pour l'îlot client.
const cards: LeakCard[] = fiches.map((fiche) => ({
  name: fiche.entity,
  sector: labelSecteur(fiche.secteur),
  size: volumeCourt(fiche.volume),
  status: labelStatut(fiche.statut),
  statusClasse: classeStatut(fiche.statut),
  time: formaterDate(dateAttribution(fiche)),
  url: urlFiche(fiche.slug),
}));

const anneeCourante = new Date().getFullYear();

const datasetJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'FrancePassoire — catalogue des fuites de données personnelles touchant la France',
  description:
    'Catalogue citoyen des fuites de données personnelles touchant la France : entités, statuts de vérification et métadonnées publiques, publiés sous licence CC-BY 4.0.',
  license: 'https://creativecommons.org/licenses/by/4.0/',
  creator: { '@type': 'Organization', name: 'FrancePassoire' },
  url: 'https://francepassoire.com',
});
---
<Layout
  title="France Passoire - On compte les trous"
  description="Observatoire citoyen et indépendant des fuites de données en France : catalogue sourcé, panorama ransomware et autoprotection — aucun chiffre inventé."
>
  <script type="application/ld+json" set:html={datasetJsonLd} slot="head" />
  <!-- Hero -->
  <section class="bg-dot-matrix border-b-2 border-brand-ink py-16 sm:py-24 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 flex flex-col items-center text-center">

      <h1 class="font-display font-extrabold text-4xl sm:text-6xl lg:text-7xl max-w-4xl leading-tight bg-brand-cream border-2 border-brand-ink shadow-hard rounded-passoire p-6 sm:p-10 mb-8 transform -rotate-1">
        La France, passoire à données.<br>
        <span class="inline-block mt-2">On compte les trous.</span>
      </h1>

      <Ticker items={tickerItems} />
    </div>
  </section>

  <!-- Bandeau compteurs : agrégats du catalogue réel (computeCompteur) -->
  <section class="bg-brand-ink text-brand-cream border-b-2 border-brand-ink py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="font-mono text-center text-sm sm:text-base tracking-wide leading-relaxed flex flex-col sm:flex-row justify-center items-center gap-2 sm:gap-4">
        <span>
          <strong class="text-brand-orange text-lg">{formaterNombre(compteur.personnesYTD)}</strong> personnes touchées depuis janvier {anneeCourante}
          <span class="text-brand-cream/70"> — {compteur.personnesLabel}</span>
        </span>
        <span class="hidden sm:inline text-brand-orange text-xl" aria-hidden="true">•</span>
        <span><strong class="text-brand-orange text-lg">{formaterNombre(compteur.fichesCount)}</strong> fiches publiées</span>
        <span class="hidden sm:inline text-brand-orange text-xl" aria-hidden="true">•</span>
        <span><strong class="text-brand-orange text-lg">{formaterNombre(compteur.statutSplit.confirmee)}</strong> confirmées · <strong class="text-brand-orange text-lg">{formaterNombre(compteur.statutSplit.revendiquee)}</strong> revendiquées</span>
      </p>
    </div>
  </section>

  <!-- Catalogue -->
  <section class="py-12 bg-brand-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Ordre de titres h1→h3 sinon (Lighthouse heading-order, tâche 44) ;
           visuellement masqué : le contrat visuel figé n'a pas de titre ici -->
      <h2 class="sr-only">Le catalogue des fuites recensées</h2>

      <CatalogFilters items={cards} />

      <!-- CTA -->
      <div class="flex flex-col sm:flex-row justify-center items-center gap-6 mt-12">
        <a href="/proteger/" class="bg-brand-orange text-brand-ink px-6 py-3 rounded-passoire border-2 border-brand-ink shadow-hard hover:bg-brand-hover btn-press transition-all font-display font-bold text-lg flex items-center gap-2">
          <svg width="20" height="20" viewBox="0 0 24 24" class="svg-ink"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
          Me prévenir
        </a>
      </div>
    </div>
  </section>
</Layout>
