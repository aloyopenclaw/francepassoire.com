---
import Layout from '../layouts/Layout.astro';
import Ticker from '../components/Ticker.astro';
import CatalogFilters from '../components/CatalogFilters.astro';
import type { TickerItem } from '../components/Ticker.astro';

// Règle Wave 0 : seules des fuites dont la source externe réelle est citée
// peuvent défiler. Aucune n'est sourcée pour l'instant : le ticker affiche
// son état vide honnête.
const tickerItems: TickerItem[] = [];
---
<Layout title="France Passoire - On compte les trous">
  <!-- Hero -->
  <section class="bg-dot-matrix border-b-2 border-brand-ink py-16 sm:py-24 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 flex flex-col items-center text-center">

      <h1 class="font-display font-extrabold text-4xl sm:text-6xl lg:text-7xl max-w-4xl leading-tight bg-brand-cream border-2 border-brand-ink shadow-hard rounded-passoire p-6 sm:p-10 mb-8 transform -rotate-1">
        La France, passoire à données.<br>
        <span class="inline-block mt-2">On compte les trous.</span>
      </h1>

      <Ticker items={tickerItems} />
    </div>
  </section>

  <!-- Bandeau compteurs : état vide honnête (aucun chiffre inventé) -->
  <section class="bg-brand-ink text-brand-cream border-b-2 border-brand-ink py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="font-mono text-center text-sm sm:text-base tracking-wide leading-relaxed flex flex-col sm:flex-row justify-center items-center gap-2 sm:gap-4">
        <span>Les compteurs s'allumeront avec les premières fiches vérifiées —</span>
        <strong class="text-brand-orange text-lg">rien d'inventé ici</strong>
      </p>
    </div>
  </section>

  <!-- Catalogue -->
  <section class="py-12 bg-brand-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <CatalogFilters items={[]} />

      <!-- CTA -->
      <div class="flex flex-col sm:flex-row justify-center items-center gap-6 mt-12">
        <a href="/proteger/" class="bg-brand-orange text-brand-ink px-6 py-3 rounded-passoire border-2 border-brand-ink shadow-hard hover:bg-brand-hover btn-press transition-all font-display font-bold text-lg flex items-center gap-2">
          <svg width="20" height="20" viewBox="0 0 24 24" class="svg-ink"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
          Me prévenir
        </a>
      </div>
    </div>
  </section>
</Layout>
