---
import Layout from '../layouts/Layout.astro';
import SignalerForm from '../components/SignalerForm.astro';
---
<Layout
  title="Signaler une fuite - France Passoire"
  description="Vous avez connaissance d'une fuite de données touchant une entité française ? Signalez-la à l'observatoire — métadonnées publiques uniquement, jamais de données volées."
>
  <!-- Hero (contrat de design : crème, bordure encre, display XXL) -->
  <section class="bg-brand-cream border-b-2 border-brand-ink py-16 text-center">
    <h1 class="font-display font-extrabold text-5xl sm:text-7xl mb-6">Signaler une fuite.</h1>
    <p class="max-w-2xl mx-auto px-4 font-body text-lg">
      Vous avez repéré une fuite de données touchant une entité française&nbsp;?
      Décrivez le contexte — l'observatoire vérifie chaque signalement avant publication.
    </p>
  </section>

  <div class="bg-brand-paper py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <SignalerForm />
    </div>
  </div>
</Layout>
