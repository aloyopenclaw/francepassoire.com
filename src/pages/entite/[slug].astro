---
// Page entité (/entite/<slug>/) — tâche 25 (Wave 3). Une page par entité
// unique du catalogue (regroupées par nom normalisé), entièrement dérivée
// des fiches : zéro curation manuelle. Catalogue vide → aucune page.
// Contrat visuel : crème + encre, ombres dures, pastilles à trous
// (Revendiquée) vs scellée verte (Confirmée) — cf. index.html.
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import {
  classeStatut,
  descriptionEntite,
  formaterDate,
  formaterNombre,
  formaterSiren,
  labelDonnee,
  labelSecteur,
  labelStatut,
  ordinalFuite,
  phraseUnite,
  regrouperParEntite,
  type EntityView,
} from '../../lib/entity-view';

export async function getStaticPaths() {
  const entries = await getCollection('catalog');
  return regrouperParEntite(entries.map((entry) => entry.data)).map((vue) => ({
    params: { slug: vue.slug },
    props: { vue },
  }));
}

interface Props {
  vue: EntityView;
}

const { vue } = Astro.props;

const nombreFiches = vue.fiches.length;
const estRecidiviste = nombreFiches >= 2;

// Rang chronologique de chaque fiche : 1 = la plus ancienne. Les fiches
// sont triées par attribution décroissante → rang = total − index.
const cartes = vue.fiches.map((fiche, index) => ({
  fiche,
  rang: nombreFiches - index,
}));

const titre = `${vue.nom} — histoire des fuites - France Passoire`;
const description = descriptionEntite(vue);
const annuaireUrl = vue.siren
  ? `https://annuaire-entreprises.data.gouv.fr/entreprise/${vue.siren}`
  : undefined;

const collectionJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${vue.nom} — histoire des fuites`,
  description,
  isAccessibleForFree: true,
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  about: {
    '@type': 'Organization',
    name: vue.nom,
    ...(vue.siren !== undefined ? { identifier: vue.siren } : {}),
  },
});
---
<Layout title={titre} description={description}>
  <script type="application/ld+json" set:html={collectionJsonLd} slot="head" />

  <section class="bg-brand-paper border-b-2 border-brand-ink">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-4">
      <a href="/" class="font-display font-bold flex items-center gap-2 hover:text-brand-orange transition-colors w-max">
        <svg width="20" height="20" viewBox="0 0 24 24" class="svg-ink" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Retour aux fuites
      </a>
    </div>
  </section>

  <!-- Hero entité -->
  <section class="bg-dot-matrix border-b-2 border-brand-ink py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <article class="bg-brand-cream border-2 border-brand-ink rounded-passoire shadow-hard p-6 sm:p-12 transform rotate-1">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <h1 class="font-display font-extrabold text-4xl sm:text-6xl">{vue.nom}</h1>
            <p class="font-mono text-sm text-brand-ink/70 mt-4">
              {nombreFiches === 1 && (
                <>1 fiche recensée · fuite du {formaterDate(vue.derniereDate)}</>
              )}
              {nombreFiches > 1 && (
                <>{formaterNombre(nombreFiches)} fiches recensées · de {formaterDate(vue.premiereDate)} à {formaterDate(vue.derniereDate)}</>
              )}
            </p>
            {annuaireUrl && vue.siren && (
              <p class="font-mono text-sm mt-2">
                SIREN{' '}
                <a href={annuaireUrl} target="_blank" rel="noopener noreferrer" class="underline decoration-2 underline-offset-2 hover:text-brand-orange transition-colors font-bold">
                  {formaterSiren(vue.siren)}
                  <span class="sr-only"> — fiche annuaire-entreprises.data.gouv.fr (nouvelle fenêtre)</span>
                </a>
                <svg width="14" height="14" viewBox="0 0 24 24" class="svg-ink inline-block ml-1" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
              </p>
            )}
          </div>
          {estRecidiviste && (
            <span class="bg-brand-ink text-brand-cream border-2 border-brand-ink px-4 py-2 rounded-full font-display font-bold text-sm shadow-sm flex items-center gap-2 transform -rotate-2">
              <span class="font-mono font-bold text-brand-orange" aria-hidden="true">{ordinalFuite(nombreFiches)}</span>
              fuite recensée
            </span>
          )}
        </div>
      </article>
    </div>
  </section>

  <!-- Historique des fuites -->
  <section class="py-12 bg-brand-paper">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="font-display font-extrabold text-2xl sm:text-3xl mb-2 flex items-center gap-2">
        <svg width="24" height="24" viewBox="0 0 24 24" class="svg-ink" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        {estRecidiviste ? 'Toutes ses fuites' : 'Sa fuite'}
      </h2>
      <p class="font-mono text-sm text-brand-ink/70 mb-8">
        {nombreFiches === 1
          ? 'Une seule fuite recensée à ce jour — jamais deux sans preuve.'
          : `${formaterNombre(nombreFiches)} fuites recensées, de la plus récente à la première.`}
      </p>

      <div class="relative pl-8 pb-4">
        <div class="timeline-line" aria-hidden="true"></div>
        <ol class="space-y-6 list-none">
          {cartes.map(({ fiche, rang }) => (
            <li class="relative z-10">
              <div class="absolute -left-[37px] top-5 w-5 h-5 bg-brand-orange border-2 border-brand-ink rounded-full shadow-[2px_2px_0px_0px_#241405]" aria-hidden="true"></div>
              <a href={`/fuite/${fiche.slug}/`} class="block bg-brand-cream border-2 border-brand-ink rounded-xl shadow-hard-sm card-hover transition-all p-4 sm:p-6">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <p class="font-mono text-sm text-brand-ink/70">
                    <span class="font-bold text-brand-ink">{ordinalFuite(rang)} fuite</span>
                    {' · '}entrée dans l'espace public le <time datetime={fiche.dates.revendication}>{formaterDate(fiche.dates.revendication)}</time>
                  </p>
                  <span class={`${classeStatut(fiche.statut)} px-3 py-1 rounded-full font-display font-bold text-sm shadow-sm flex items-center gap-1.5 w-max`}>
                    <span class={`block w-2 h-2 rounded-full ${fiche.statut === 'confirmee' ? 'bg-brand-cream' : 'bg-brand-ink motion-safe:animate-pulse'}`} aria-hidden="true"></span>
                    {labelStatut(fiche.statut)}
                  </span>
                </div>
                <h3 class="font-display font-extrabold text-2xl sm:text-3xl text-brand-hover drop-shadow-[1px_1px_0px_rgba(36,20,5,1)] mt-3">
                  {formaterNombre(fiche.volume.count)} {phraseUnite(fiche.volume.unit)}
                </h3>
                <p class="font-mono text-xs text-brand-ink/70 mt-2 leading-relaxed">{fiche.volume.label}</p>
                <div class="flex flex-wrap gap-2 mt-4">
                  <span class="bg-brand-paper border-2 border-brand-ink rounded-full px-3 py-1 font-mono text-xs font-bold">{labelSecteur(fiche.secteur)}</span>
                  {fiche.data_types.map((type) => (
                    <span class="bg-brand-paper border-2 border-brand-ink rounded-md px-2.5 py-1 font-mono text-xs">{labelDonnee(type)}</span>
                  ))}
                </div>
              </a>
            </li>
          ))}
        </ol>
      </div>

      <div class="flex flex-col items-center gap-6 mt-12">
        <p class="text-center font-mono text-sm text-brand-ink/60">
          <span class="bg-brand-cream border-2 border-brand-ink inline-block px-4 py-2 rounded-full">
            Chaque fiche renvoie à ses sources citées — <a href="/methode/" class="underline hover:text-brand-orange">voir la méthode</a>.
          </span>
        </p>
        <a href="/proteger/" class="bg-brand-orange text-brand-ink px-6 py-3 rounded-passoire border-2 border-brand-ink shadow-hard hover:bg-brand-hover btn-press transition-all font-display font-bold text-lg flex items-center gap-2">
          <svg width="20" height="20" viewBox="0 0 24 24" class="svg-ink" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
          Me prévenir
        </a>
      </div>
    </div>
  </section>
</Layout>
