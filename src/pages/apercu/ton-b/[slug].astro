---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import FichePage from '../../../components/FichePage.astro';
import { RESUMES_TONS, TITRES_TONS, type Ton } from '../../../lib/prose-tones';

// Préversion rédactionnelle (tâche 21) : la fiche complète, rendue avec la
// proposition de prose Ton B « Pédagogique citoyen ». Route de
// prévisualisation uniquement — n'existe pas en production (décision n° 6).
export function getStaticPaths() {
  return getCollection('catalog').then((entries) =>
    entries.map((entry) => ({
      params: { slug: entry.data.slug },
      props: { fiche: entry.data },
    })),
  );
}

const { fiche } = Astro.props;
const TON = 'b' as const;
const AUTRES_TONS = (['a', 'b', 'c'] as const).filter((ton) => ton !== TON) as readonly Ton[];
---
<Layout
  title={`Aperçu ${TITRES_TONS[TON]} — ${fiche.entity} - France Passoire`}
  description={`Proposition de prose (${TITRES_TONS[TON]}) pour la fiche ${fiche.entity}. Préversion de la gate de style — non verrouillée.`}
>
  <nav aria-label="Choix du ton de prose" class="bg-brand-ink text-brand-cream border-b-2 border-brand-ink">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-sm">
      <span class="font-bold">Préversion · {TITRES_TONS[TON]}</span>
      <span class="text-brand-cream/70 hidden sm:inline">{RESUMES_TONS[TON]}</span>
      <span class="flex-1"></span>
      {AUTRES_TONS.map((ton) => (
        <a href={`/apercu/ton-${ton}/${fiche.slug}/`} class="underline decoration-2 underline-offset-4 hover:text-brand-orange transition-colors">Comparer : {TITRES_TONS[ton]}</a>
      ))}
      <a href={`/fiche/${fiche.slug}/`} class="underline decoration-2 underline-offset-4 hover:text-brand-orange transition-colors">Fiche de référence</a>
    </div>
  </nav>
  <FichePage fiche={fiche} ton={TON} />
</Layout>
