---
import Layout from '../layouts/Layout.astro';
import PasswordChecker from '../components/PasswordChecker.astro';
import DpoGenerator from '../components/DpoGenerator.astro';
import WatchlistForm from '../components/WatchlistForm.astro';
---
<Layout
  title="Se protéger - France Passoire"
  description="Vérifiez vos mots de passe (k-anonymité) et agissez concrètement : le guide d'autoprotection de FrancePassoire."
>
  <!-- Hero -->
  <section class="bg-brand-cream border-b-2 border-brand-ink py-16 text-center">
    <h1 class="font-display font-extrabold text-5xl sm:text-7xl mb-12">Ne subissez plus.</h1>
    <div class="flex flex-wrap justify-center gap-6 px-4">
      <a href="#proteger-verifier" class="bg-brand-orange border-2 border-brand-ink px-8 py-4 rounded-passoire shadow-[4px_4px_0px_0px_#241405] hover:-translate-y-1 hover:shadow-[6px_6px_0px_0px_#241405] transition-all font-display font-bold text-xl">1. Vérifier</a>
      <a href="#proteger-agir" class="bg-brand-paper border-2 border-brand-ink px-8 py-4 rounded-passoire shadow-[4px_4px_0px_0px_#241405] hover:-translate-y-1 hover:shadow-[6px_6px_0px_0px_#241405] transition-all font-display font-bold text-xl">2. Agir</a>
      <a href="#proteger-surveiller" class="bg-[#0E7A46] text-brand-cream border-2 border-brand-ink px-8 py-4 rounded-passoire shadow-[4px_4px_0px_0px_#241405] hover:-translate-y-1 hover:shadow-[6px_6px_0px_0px_#241405] transition-all font-display font-bold text-xl">3. Surveiller</a>
    </div>
  </section>

  <!-- Bandeau retour veille : ?veille=confirmee|invalide|desinscrit (T30) -->
  <div id="veille-banner" class="max-w-4xl mx-auto px-4 sm:px-6 mt-8" role="status" aria-live="polite" hidden>
    <div id="veille-banner-card" class="border-2 border-brand-ink rounded-passoire shadow-hard bg-brand-cream overflow-hidden">
      <div id="veille-banner-strip" class="bg-brand-orange border-b-2 border-brand-ink px-5 py-2 flex items-center gap-2" style="background-image:radial-gradient(circle,#241405 1.3px,transparent 1.3px);background-size:22px 22px;">
        <span data-pastille class="w-3 h-3 rounded-full border-2 border-brand-ink bg-brand-ink"></span>
        <span id="veille-banner-icon" class="font-mono text-xs font-bold text-brand-ink bg-brand-paper border-2 border-brand-ink rounded-full px-2 py-0.5"></span>
      </div>
      <p id="veille-banner-text" class="px-5 py-4 font-body font-medium text-brand-ink leading-relaxed"></p>
    </div>
  </div>

  <div class="bg-brand-paper space-y-24 py-16">

    <!-- SECTION 1: VERIFIER -->
    <section id="proteger-verifier" class="max-w-7xl mx-auto px-4 sm:px-6 scroll-mt-24">
      <h2 class="font-display font-black text-4xl mb-8 flex items-center gap-3">
        <span class="bg-brand-orange w-10 h-10 rounded-full flex items-center justify-center border-2 border-brand-ink shadow-sm text-2xl">1</span>
        Vérifier
      </h2>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Vérificateur de mot de passe (k-anonymité réelle) -->
        <PasswordChecker />

        <!-- Liens externes réels uniquement -->
        <div class="grid grid-cols-1 gap-4">
          <a href="https://haveibeenpwned.com" target="_blank" rel="noopener noreferrer" class="bg-brand-cream border-2 border-brand-ink rounded-xl p-5 shadow-[4px_4px_0px_0px_#241405] hover:shadow-[6px_6px_0px_0px_#241405] hover:-translate-y-1 transition-all flex items-center justify-between group">
            <div>
              <h4 class="font-display font-bold text-xl">Votre email</h4>
              <p class="font-body text-sm opacity-80">Vérifiez sur la référence mondiale HaveIBeenPwned.</p>
            </div>
            <svg width="24" height="24" viewBox="0 0 24 24" class="svg-ink group-hover:text-brand-orange"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
          </a>

          <!-- Template : lien ancre-vide mort → ressource officielle réelle (cybermalveillance.gouv.fr, curl 200). Copie template exacte, seul le href diffère. -->
          <a href="https://www.cybermalveillance.gouv.fr" target="_blank" rel="noopener noreferrer" class="bg-brand-cream border-2 border-brand-ink rounded-xl p-5 shadow-[4px_4px_0px_0px_#241405] hover:shadow-[6px_6px_0px_0px_#241405] hover:-translate-y-1 transition-all flex items-center justify-between group">
            <div>
              <h4 class="font-display font-bold text-xl">Votre numéro de téléphone</h4>
              <p class="font-body text-sm opacity-80">Guide : les outils qui existent pour vérifier.</p>
            </div>
            <svg width="24" height="24" viewBox="0 0 24 24" class="svg-ink group-hover:text-brand-orange"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>

          <a href="https://myactivity.google.com/results-about-you" target="_blank" rel="noopener noreferrer" class="bg-brand-cream border-2 border-brand-ink rounded-xl p-5 shadow-[4px_4px_0px_0px_#241405] hover:shadow-[6px_6px_0px_0px_#241405] hover:-translate-y-1 transition-all flex items-center justify-between group">
            <div>
              <h4 class="font-display font-bold text-xl">Votre nom / adresse</h4>
              <p class="font-body text-sm opacity-80">Gérez l'outil Google "Résultats vous concernant".</p>
            </div>
            <svg width="24" height="24" viewBox="0 0 24 24" class="svg-ink group-hover:text-brand-orange"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- SECTION 2: AGIR -->
    <section id="proteger-agir" class="max-w-7xl mx-auto px-4 sm:px-6 scroll-mt-24">
      <h2 class="font-display font-black text-4xl mb-8 flex items-center gap-3">
        <span class="bg-brand-paper w-10 h-10 rounded-full flex items-center justify-center border-2 border-brand-ink shadow-sm text-2xl">2</span>
        Agir
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <!-- Les 3 gestes -->
        <div>
          <h3 class="font-display font-extrabold text-2xl mb-6">L'hygiène vitale : les 3 gestes</h3>
          <div class="space-y-4">
            <div class="bg-brand-cream border-2 border-brand-ink p-5 rounded-xl flex gap-4 items-start shadow-[3px_3px_0px_0px_#241405]">
              <div class="font-mono font-bold text-3xl text-brand-hover drop-shadow-[1px_1px_0px_rgba(36,20,5,1)] mt-[-4px]">1</div>
              <div>
                <h4 class="font-display font-bold text-lg">Changer le mot de passe (et l'uniquefier)</h4>
                <p class="text-sm mt-1">Utilisez un gestionnaire de mots de passe pour avoir un mot de passe long et unique par site.</p>
              </div>
            </div>
            <div class="bg-brand-cream border-2 border-brand-ink p-5 rounded-xl flex gap-4 items-start shadow-[3px_3px_0px_0px_#241405]">
              <div class="font-mono font-bold text-3xl text-brand-hover drop-shadow-[1px_1px_0px_rgba(36,20,5,1)] mt-[-4px]">2</div>
              <div>
                <h4 class="font-display font-bold text-lg">Activer la double authentification</h4>
                <p class="text-sm mt-1">Surtout sur la boîte mail (qui permet de réinitialiser tous les autres comptes).</p>
              </div>
            </div>
            <div class="bg-brand-cream border-2 border-brand-ink p-5 rounded-xl flex gap-4 items-start shadow-[3px_3px_0px_0px_#241405]">
              <div class="font-mono font-bold text-3xl text-brand-hover drop-shadow-[1px_1px_0px_rgba(36,20,5,1)] mt-[-4px]">3</div>
              <div>
                <h4 class="font-display font-bold text-lg">Surveiller ses comptes</h4>
                <p class="text-sm mt-1">Vérifiez vos relevés bancaires et soyez ultra-vigilants sur les appels/SMS inconnus.</p>
              </div>
            </div>
          </div>

          <a href="#proteger-dpo" class="mt-4 flex items-center justify-between gap-4 bg-brand-paper border-2 border-brand-ink rounded-xl p-5 shadow-[3px_3px_0px_0px_#241405] hover:bg-brand-orange/10 transition-colors group">
            <div>
              <h4 class="font-display font-bold text-lg">Et si vos données ont déjà fuité ?</h4>
              <p class="text-sm mt-1">Exercez vos droits RGPD : générez une lettre type pour le DPO de l'entreprise concernée.</p>
            </div>
            <svg width="22" height="22" viewBox="0 0 24 24" class="svg-ink flex-shrink-0 group-hover:stroke-brand-orange"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </a>
        </div>

        <!-- Scenarios -->
        <div>
          <h3 class="font-display font-extrabold text-2xl mb-6">Que faire si...</h3>
          <div class="space-y-4">
            <details class="group bg-brand-cream border-2 border-brand-ink rounded-xl shadow-[3px_3px_0px_0px_#241405] overflow-hidden">
              <summary class="p-5 font-display font-bold text-lg cursor-pointer flex justify-between items-center hover:bg-brand-orange/10 transition-colors">
                J'ai reçu un mail de l'entreprise
                <svg width="20" height="20" viewBox="0 0 24 24" class="svg-ink transition-transform group-open:rotate-180"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </summary>
              <div class="p-5 pt-0 text-sm font-body border-t-2 border-brand-ink/10 mt-2">
                Si l'entreprise vous notifie d'une fuite, appliquez immédiatement les 3 gestes sur votre compte chez eux. <strong>Attention :</strong> ne cliquez jamais sur un lien dans ce mail pour changer votre mot de passe, tapez l'adresse du site vous-même dans le navigateur (risque de phishing).
              </div>
            </details>

            <details class="group bg-brand-cream border-2 border-brand-ink rounded-xl shadow-[3px_3px_0px_0px_#241405] overflow-hidden">
              <summary class="p-5 font-display font-bold text-lg cursor-pointer flex justify-between items-center hover:bg-brand-orange/10 transition-colors">
                Mon email est dans une fuite
                <svg width="20" height="20" viewBox="0 0 24 24" class="svg-ink transition-transform group-open:rotate-180"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </summary>
              <div class="p-5 pt-0 text-sm font-body border-t-2 border-brand-ink/10 mt-2">
                Attendez-vous à recevoir davantage de spams et de tentatives de phishing. Méfiez-vous des emails alarmants (colis bloqués, compte suspendu, amendes). Ne payez jamais de rançon d'extorsion par email.
              </div>
            </details>

            <details class="group bg-brand-cream border-2 border-brand-ink rounded-xl shadow-[3px_3px_0px_0px_#241405] overflow-hidden">
              <summary class="p-5 font-display font-bold text-lg cursor-pointer flex justify-between items-center hover:bg-brand-orange/10 transition-colors">
                Mon numéro a fuité
                <svg width="20" height="20" viewBox="0 0 24 24" class="svg-ink transition-transform group-open:rotate-180"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </summary>
              <div class="p-5 pt-0 text-sm font-body border-t-2 border-brand-ink/10 mt-2">
                Alerte rouge sur le "smishing" (phishing par SMS) et les appels frauduleux (faux conseiller bancaire). Votre banque ne vous demandera jamais d'annuler une opération par SMS ou de lui donner un code. Raccrochez et rappelez le numéro officiel.
              </div>
            </details>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: SURVEILLER (veille email double opt-in + lettre type DPO) -->
    <section id="proteger-surveiller" class="max-w-4xl mx-auto px-4 sm:px-6 pb-16 scroll-mt-24">
      <h2 class="font-display font-black text-4xl mb-8 flex items-center gap-3">
        <span class="bg-[#0E7A46] text-brand-cream w-10 h-10 rounded-full flex items-center justify-center border-2 border-brand-ink shadow-sm text-2xl">3</span>
        Surveiller
      </h2>

      <WatchlistForm />

      <!-- Slot « Lettre type au DPO » du template : notre vrai générateur 100 % local -->
      <div id="proteger-dpo" class="mt-12 scroll-mt-24">
        <h3 class="font-display font-extrabold text-2xl mb-2">Et si vos données ont déjà fuité ? Exiger ses droits</h3>
        <p class="font-body mb-8 max-w-3xl">
          Un mois : c'est le délai légal dont dispose une organisation pour répondre à une demande RGPD.
          Une lettre claire, article en main, débloque la plupart des situations — générez la vôtre ci-dessous,
          elle s'écrit entièrement dans votre navigateur.
        </p>
        <DpoGenerator />
      </div>
    </section>

  </div>

  <script is:inline>
    // Bandeau de retour de la veille (T30) : confirm / désinscription
    // redirigent ici avec ?veille=… — le paramètre est consommé puis retiré
    // de l'URL (history.replaceState) pour ne pas ressurgir au rechargement.
    (function () {
      var params = new URLSearchParams(window.location.search);
      var veille = params.get('veille');
      if (!veille) return;
      var textes = {
        confirmee: {
          texte: 'Veille confirmée. Vous recevrez vos alertes selon la fréquence choisie — désinscription en un clic dans chaque email.',
          badge: 'VEILLE ACTIVE',
          pastille: 'bg-brand-green',
          strip: 'bg-brand-green'
        },
        invalide: {
          texte: 'Lien de confirmation invalide ou expiré (validité 24 heures). Relancez une inscription ci-dessous pour recevoir un nouveau lien.',
          badge: 'LIEN EXPIRE',
          pastille: 'bg-brand-hover',
          strip: 'bg-brand-hover'
        },
        desinscrit: {
          texte: 'Vous êtes désinscrit de la veille email. Votre adresse et vos préférences ont été supprimées.',
          badge: 'DESINSCRIT',
          pastille: 'bg-brand-ink',
          strip: 'bg-brand-ink'
        }
      };
      var conf = textes[veille];
      if (!conf) return;
      params.delete('veille');
      var propre = params.toString();
      window.history.replaceState(null, '', window.location.pathname + (propre ? '?' + propre : '') + window.location.hash);
      var banner = document.getElementById('veille-banner');
      var texte = document.getElementById('veille-banner-text');
      var strip = document.getElementById('veille-banner-strip');
      var badge = document.getElementById('veille-banner-icon');
      var pastille = strip ? strip.querySelector('[data-pastille]') : null;
      if (banner && texte) {
        texte.textContent = conf.texte;
        if (strip) {
          strip.classList.remove('bg-brand-orange');
          strip.classList.add(conf.strip);
        }
        if (badge) badge.textContent = conf.badge;
        if (pastille) pastille.className = 'w-3 h-3 rounded-full border-2 border-brand-ink ' + conf.pastille;
        banner.hidden = false;
        banner.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    })();
  </script>
</Layout>
