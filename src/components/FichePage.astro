---
// Gabarit complet d'une fiche — contrat visuel : prototype `page-fiche`
// de index.html (hero passoire, chips + info-bulles, timeline, sources,
// carte d'action). Toutes les valeurs proviennent du JSON de la fiche ;
// rien n'est inventé, les absences restent honnêtes.
import type { Fiche } from '../lib/fiche-schema';
import {
  chipDonnee,
  classeStatut,
  explicationStatut,
  formaterDate,
  formaterNombre,
  formaterSiren,
  labelGenreSource,
  labelSecteur,
  labelStatut,
  phraseUnite,
} from '../lib/fiche-view';
import { prosePour, type Ton } from '../lib/prose-tones';

interface Props {
  fiche: Fiche;
  /** Ton de la description : `undefined` = champ `description` du JSON. */
  ton?: Ton;
}

const { fiche, ton } = Astro.props;

// Prose rendue : variante proposée si demandée, sinon le champ du JSON.
// Si une variante manque (fiche sans proposition), on reste honnête :
// description de référence, jamais de texte improvisé.
const prose =
  ton !== undefined ? (prosePour(fiche.slug, ton) ?? fiche.description) : fiche.description;
const proseEstVariante = ton !== undefined && prosePour(fiche.slug, ton) !== undefined;

const estConfirmee = fiche.statut === 'confirmee';
---

<section class="bg-brand-paper border-b-2 border-brand-ink">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-4">
    <a
      href="/"
      class="font-display font-bold flex items-center gap-2 hover:text-brand-orange transition-colors w-max"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" class="svg-ink" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      Retour aux fuites
    </a>
  </div>
</section>

<!-- Hero fiche -->
<section class="bg-dot-matrix border-b-2 border-brand-ink py-12">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <article class="bg-brand-cream border-2 border-brand-ink rounded-passoire shadow-hard p-6 sm:p-12 transform rotate-1">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <span class="inline-block bg-brand-paper border-2 border-brand-ink px-3 py-1 rounded-full font-mono text-sm font-bold mb-4">Secteur : {labelSecteur(fiche.secteur)}</span>
          <h1 class="font-display font-extrabold text-4xl sm:text-6xl">{fiche.entity}</h1>
        </div>
        <span class={`${classeStatut(fiche.statut)} px-4 py-2 rounded-full font-display font-bold text-sm shadow-sm flex items-center gap-2`}>
          <span class={`block w-2 h-2 rounded-full ${estConfirmee ? 'bg-brand-cream' : 'bg-brand-ink animate-pulse'}`} aria-hidden="true"></span>
          {labelStatut(fiche.statut)}
        </span>
      </div>

      <p class="font-mono text-sm text-brand-ink/70 mt-4">
        Entrée dans l'espace public : {formaterDate(fiche.dates.revendication)}
        {fiche.siren && <> · SIREN {formaterSiren(fiche.siren)}</>}
      </p>
      <p class="text-sm mt-2 text-brand-ink/80">{explicationStatut(fiche.statut)}</p>

      <div class="mt-8 pt-8 border-t-2 border-brand-ink/20 border-dashed">
        <p class="font-mono text-lg mb-2">Volume annoncé :</p>
        <p class="font-display font-extrabold text-3xl sm:text-5xl text-brand-orange drop-shadow-[2px_2px_0px_rgba(36,20,5,1)]">
          {formaterNombre(fiche.volume.count)} {phraseUnite(fiche.volume.unit)}
        </p>
        <p class="font-mono text-sm text-brand-ink/70 mt-3 leading-relaxed">{fiche.volume.label}</p>
      </div>
    </article>
  </div>
</section>

<!-- Contenu -->
<section class="py-12 bg-brand-paper">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 grid grid-cols-1 md:grid-cols-3 gap-12">

    <!-- Colonne gauche -->
    <div class="md:col-span-2 space-y-12">

      <!-- Le résumé (prose) -->
      <div>
        <h2 class="font-display font-extrabold text-2xl mb-4 flex items-center gap-2">
          <svg width="24" height="24" viewBox="0 0 24 24" class="svg-ink" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
          Ce que l'on sait
        </h2>
        <div class="bg-brand-cream border-2 border-brand-ink rounded-xl p-5 shadow-hard-sm">
          {proseEstVariante && (
            <p class="font-mono text-xs text-brand-ink/60 mb-3 border-b-2 border-dashed border-brand-ink/20 pb-3">
              Proposition de prose en préversion — non verrouillée.
            </p>
          )}
          <p class="font-body text-lg leading-relaxed">{prose}</p>
        </div>
      </div>

      <!-- Données exposées (chips + info-bulles) -->
      <div>
        <h2 class="font-display font-extrabold text-2xl mb-6 flex items-center gap-2">
          <svg width="24" height="24" viewBox="0 0 24 24" class="svg-ink" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
          Données annoncées
        </h2>
        <div class="flex flex-wrap gap-3">
          {fiche.data_types.map((type) => {
            const chip = chipDonnee(type);
            return (
              <div class="tooltip-trigger relative" tabindex="0">
                <span class="inline-block bg-brand-cream border-2 border-brand-ink rounded-md px-3 py-1.5 font-mono text-sm shadow-[2px_2px_0px_0px_#241405] cursor-help">{chip.label}</span>
                <div role="tooltip" class="tooltip-content absolute bottom-full left-0 mb-2 w-64 bg-brand-ink text-brand-cream p-3 rounded-lg text-sm font-body shadow-hard-sm">
                  {chip.tooltip}
                </div>
              </div>
            );
          })}
        </div>
        <p class="font-mono text-xs text-brand-ink/60 mt-4">
          Seules les catégories listées par les sources figurent ici — survolez ou mettez le focus sur une puce pour le risque associé.
        </p>
      </div>

      <!-- Historique -->
      <div>
        <h2 class="font-display font-extrabold text-2xl mb-6 flex items-center gap-2">
          <svg width="24" height="24" viewBox="0 0 24 24" class="svg-ink" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          Historique
        </h2>
        <div class="relative pl-8 pb-4">
          <div class="timeline-line" aria-hidden="true"></div>
          {fiche.timeline.map((entree) => (
            <div class="relative z-10 flex items-center mb-6 last:mb-0">
              <div class="absolute -left-[37px] w-5 h-5 bg-brand-orange border-2 border-brand-ink rounded-full shadow-[2px_2px_0px_0px_#241405]" aria-hidden="true"></div>
              <div class="bg-brand-cream border-2 border-brand-ink p-4 rounded-xl shadow-hard-sm w-full">
                <p class="font-mono text-sm text-brand-ink/70 mb-1">
                  <time datetime={entree.date}>{formaterDate(entree.date)}</time>
                </p>
                <p class="font-body leading-relaxed">{entree.event}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Sources -->
      <div>
        <h2 class="font-display font-extrabold text-2xl mb-4 flex items-center gap-2">
          <svg width="24" height="24" viewBox="0 0 24 24" class="svg-ink" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
          Sources
        </h2>
        <ul class="space-y-3">
          {fiche.sources.map((source) => (
            <li class="bg-brand-cream border-2 border-brand-ink rounded-xl p-4 shadow-[2px_2px_0px_0px_#241405] flex flex-wrap items-center gap-3">
              <span class="font-mono text-xs font-bold uppercase tracking-wide bg-brand-paper border border-brand-ink px-2 py-0.5 rounded-full">{labelGenreSource(source.kind)}</span>
              <a href={source.url} target="_blank" rel="noopener noreferrer" class="underline decoration-2 underline-offset-2 hover:text-brand-orange transition-colors font-body text-sm leading-snug flex-1 min-w-[12rem]">
                {source.label}
                <span class="sr-only"> (nouvelle fenêtre)</span>
              </a>
              <svg width="16" height="16" viewBox="0 0 24 24" class="svg-ink shrink-0" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Colonne droite : les 3 gestes -->
    <div>
      <aside class="bg-brand-orange border-2 border-brand-ink rounded-passoire shadow-hard p-6 sticky top-24 transform rotate-1 hover:rotate-0 transition-transform">
        <h2 class="font-display font-extrabold text-2xl mb-2 text-brand-ink">Vous aviez un compte ?</h2>
        <p class="font-body font-bold text-brand-ink/80 mb-6">Les 3 gestes immédiats, dans l'ordre.</p>

        <ol class="space-y-4 list-none">
          <li class="bg-brand-cream border-2 border-brand-ink p-4 rounded-xl flex gap-4 items-start shadow-[3px_3px_0px_0px_#241405]">
            <div class="font-mono font-bold text-3xl text-brand-orange drop-shadow-[1px_1px_0px_rgba(36,20,5,1)] mt-[-4px]" aria-hidden="true">1</div>
            <div>
              <h3 class="font-display font-bold text-lg leading-tight">Changer le mot de passe</h3>
              <p class="text-sm mt-1 leading-snug">Surtout si vous le réutilisez ailleurs.</p>
            </div>
          </li>
          <li class="bg-brand-cream border-2 border-brand-ink p-4 rounded-xl flex gap-4 items-start shadow-[3px_3px_0px_0px_#241405]">
            <div class="font-mono font-bold text-3xl text-brand-orange drop-shadow-[1px_1px_0px_rgba(36,20,5,1)] mt-[-4px]" aria-hidden="true">2</div>
            <div>
              <h3 class="font-display font-bold text-lg leading-tight">Activer la double authentification</h3>
              <p class="text-sm mt-1 leading-snug">Sur votre boîte mail principale en priorité.</p>
            </div>
          </li>
          <li class="bg-brand-cream border-2 border-brand-ink p-4 rounded-xl flex gap-4 items-start shadow-[3px_3px_0px_0px_#241405]">
            <div class="font-mono font-bold text-3xl text-brand-orange drop-shadow-[1px_1px_0px_rgba(36,20,5,1)] mt-[-4px]" aria-hidden="true">3</div>
            <div>
              <h3 class="font-display font-bold text-lg leading-tight">Surveiller ses comptes</h3>
              <p class="text-sm mt-1 leading-snug">Méfiez-vous des SMS et appels inhabituels.</p>
            </div>
          </li>
        </ol>

        <a href="/proteger/#proteger-agir" class="w-full mt-6 inline-flex justify-center items-center gap-2 bg-brand-ink text-brand-cream px-4 py-3 rounded-xl border-2 border-brand-ink shadow-[4px_4px_0px_0px_#FFF9F2] hover:bg-brand-paper hover:text-brand-ink btn-press transition-all font-display font-bold text-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" class="svg-ink" stroke="currentColor" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
          Le guide complet
        </a>
        <a href="/proteger/#proteger-verifier" class="block text-center mt-3 font-body font-bold text-brand-ink underline decoration-2 underline-offset-4 hover:opacity-80 transition-opacity">
          Vérifier d'abord vos mots de passe
        </a>
      </aside>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 mt-12">
    <p class="text-center font-mono text-sm text-brand-ink/60">
      <span class="bg-brand-cream border-2 border-brand-ink inline-block px-4 py-2 rounded-full">
        Chaque fait de cette fiche renvoie à une source citée — <a href="/methode/" class="underline hover:text-brand-orange">voir la méthode</a>.
      </span>
    </p>
  </div>
</section>
