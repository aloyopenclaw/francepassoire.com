---
/**
 * Catalogue des fuites + filtres — îlot client.
 * Les 24 premières cartes sont rendues au build (SSR, liens /fiche/<slug>/) ;
 * les filtres secteur/statut et « Afficher plus » travaillent côté client
 * sur le jeu complet passé en props (define:vars). L'état vide n'existe que
 * pour un filtre sans résultat : « Aucune fuite ne correspond à ces critères ».
 */
export interface LeakCard {
  name: string;
  sector: string;
  size: string;
  status: string;
  statusClasse: string;
  time: string;
  url: string;
}

interface Props {
  items?: LeakCard[];
  /** Cartes rendues au build — les suivantes via « Afficher plus ». */
  initialCount?: number;
}

const { items = [], initialCount = 24 } = Astro.props;
const step = 24;

// Options de secteur dérivées du catalogue réel (libellés déjà résolus).
const secteurs = [...new Set(items.map((item) => item.sector))].sort((a, b) =>
  a.localeCompare(b, 'fr'),
);
---
<div class="flex flex-wrap items-center gap-4 mb-8 bg-brand-cream border-2 border-brand-ink rounded-passoire p-4 shadow-hard-sm">
  <span class="font-display font-bold flex items-center gap-2">
    <svg width="20" height="20" viewBox="0 0 24 24" class="svg-ink"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
    Filtrer
  </span>
  <select id="filter-secteur" aria-label="Filtrer par secteur" class="appearance-none bg-brand-paper border-2 border-brand-ink rounded-full px-4 py-1.5 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-brand-ink cursor-pointer hover:bg-brand-orange hover:text-brand-ink transition-colors">
    <option value="all">Tous secteurs</option>
    {secteurs.map((secteur) => (
      <option value={secteur}>{secteur}</option>
    ))}
  </select>
  <select id="filter-statut" aria-label="Filtrer par statut" class="appearance-none bg-brand-paper border-2 border-brand-ink rounded-full px-4 py-1.5 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-brand-ink cursor-pointer hover:bg-brand-orange hover:text-brand-ink transition-colors">
    <option value="all">Tous statuts</option>
    <option value="Revendiquée">Revendiquée</option>
    <option value="Confirmée">Confirmée</option>
  </select>
  <button id="filter-reset" type="button" class="text-sm font-display underline decoration-2 hover:text-brand-orange ml-auto">Réinitialiser</button>
</div>

<div id="leaks-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-2 gap-6 mb-12">
  {items.slice(0, initialCount).map((card) => (
    <a href={card.url} class="block bg-brand-cream border-2 border-brand-ink rounded-passoire shadow-hard p-6 card-hover transition-all">
      <div>
        <div class="flex justify-between items-start mb-4 gap-2">
          <span class="font-mono text-sm font-bold border-b-2 border-brand-ink pb-1">{card.sector}</span>
          <span class="font-mono text-sm text-brand-ink/60">{card.time}</span>
        </div>
        <h3 class="font-display font-extrabold text-2xl mb-2 line-clamp-2">{card.name}</h3>
        <p class="font-mono text-xl text-brand-hover drop-shadow-[1px_1px_0px_rgba(36,20,5,1)] font-bold mb-6">{card.size}</p>
      </div>
      <span class={`${card.statusClasse} px-3 py-1 rounded-full font-display font-bold text-sm shadow-sm inline-flex items-center gap-1.5`}>
        <span class={`block w-2 h-2 rounded-full ${card.status === 'Confirmée' ? 'bg-brand-cream' : 'bg-brand-ink motion-safe:animate-pulse'}`} aria-hidden="true"></span>
        {card.status}
      </span>
    </a>
  ))}
</div>

{items.length > initialCount && (
  <div class="flex justify-center mb-12">
    <button id="leaks-more" type="button" class="bg-brand-cream text-brand-ink px-6 py-3 rounded-passoire border-2 border-brand-ink shadow-hard hover:bg-brand-paper btn-press transition-all font-display font-bold text-lg flex items-center gap-2">
      <svg width="20" height="20" viewBox="0 0 24 24" class="svg-ink" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      Afficher plus
    </button>
  </div>
)}

<script define:vars={{ items, initialCount, step }}>
  const grid = document.getElementById('leaks-grid');
  const filterSecteur = document.getElementById('filter-secteur');
  const filterStatut = document.getElementById('filter-statut');
  const resetButton = document.getElementById('filter-reset');
  const moreButton = document.getElementById('leaks-more');
  if (grid && filterSecteur && filterStatut && resetButton) {
    let visible = initialCount;

    const card = (leak) => {
      const isConfirm = leak.status === 'Confirmée';
      const a = document.createElement('a');
      a.href = leak.url;
      a.className = 'block bg-brand-cream border-2 border-brand-ink rounded-passoire shadow-hard p-6 card-hover transition-all';
      a.innerHTML = `
        <div>
          <div class="flex justify-between items-start mb-4 gap-2">
            <span class="font-mono text-sm font-bold border-b-2 border-brand-ink pb-1"></span>
            <span class="font-mono text-sm text-brand-ink/60"></span>
          </div>
          <h3 class="font-display font-extrabold text-2xl mb-2 line-clamp-2"></h3>
          <p class="font-mono text-xl text-brand-hover drop-shadow-[1px_1px_0px_rgba(36,20,5,1)] font-bold mb-6"></p>
        </div>
        <span class="${leak.statusClasse} px-3 py-1 rounded-full font-display font-bold text-sm shadow-sm inline-flex items-center gap-1.5">
          <span class="block w-2 h-2 rounded-full ${isConfirm ? 'bg-brand-cream' : 'bg-brand-ink motion-safe:animate-pulse'}" aria-hidden="true"></span>
        </span>`;
      const header = a.firstElementChild.firstElementChild;
      header.children[0].textContent = leak.sector;
      header.children[1].textContent = leak.time;
      a.querySelector('h3').textContent = leak.name;
      a.querySelector('p').textContent = leak.size;
      a.lastElementChild.append(leak.status);
      return a;
    };

    const noMatchState = () => {
      const d = document.createElement('div');
      d.className = 'col-span-full py-12 text-center font-display text-xl text-brand-ink/50';
      d.textContent = 'Aucune fuite ne correspond à ces critères (heureusement).';
      return d;
    };

    const filtered = () =>
      items.filter((leak) =>
        (filterSecteur.value === 'all' || leak.sector === filterSecteur.value) &&
        (filterStatut.value === 'all' || leak.status === filterStatut.value)
      );

    // Met à jour le bouton sans toucher à la grille (l'état SSR reste intact
    // jusqu'à la première interaction filtre).
    const updateMore = () => {
      if (!moreButton) return;
      const total = filtered().length;
      if (total > visible) {
        moreButton.classList.remove('hidden');
        moreButton.lastChild.textContent = ` Afficher plus (${total - visible} restantes)`;
      } else {
        moreButton.classList.add('hidden');
      }
    };

    const render = () => {
      const data = filtered().slice(0, visible);
      grid.replaceChildren();
      if (data.length === 0) {
        grid.append(noMatchState());
      } else {
        data.forEach((leak) => grid.append(card(leak)));
      }
      updateMore();
    };

    updateMore();
    filterSecteur.addEventListener('change', () => { visible = step; render(); });
    filterStatut.addEventListener('change', () => { visible = step; render(); });
    resetButton.addEventListener('click', () => {
      filterSecteur.value = 'all';
      filterStatut.value = 'all';
      visible = step;
      render();
    });
    if (moreButton) {
      moreButton.addEventListener('click', () => { visible += step; render(); });
    }
  }
</script>
