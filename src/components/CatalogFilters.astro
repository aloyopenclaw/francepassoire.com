---
/**
 * Catalogue des fuites + filtres — îlot client.
 * Les cartes proviennent du catalogue validé : vide à ce stade, la grille
 * affiche l'état vide honnête « Catalogue en préparation ».
 */
export interface LeakCard {
  name: string;
  sector: string;
  size: string;
  status: 'Revendiquée' | 'Confirmée';
  time: string;
}

interface Props {
  items?: LeakCard[];
}

const { items = [] } = Astro.props;
const isEmptyCatalog = items.length === 0;
---
<div class="flex flex-wrap items-center gap-4 mb-8 bg-brand-cream border-2 border-brand-ink rounded-passoire p-4 shadow-hard-sm">
  <span class="font-display font-bold flex items-center gap-2">
    <svg width="20" height="20" viewBox="0 0 24 24" class="svg-ink"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
    Filtrer
  </span>
  <select id="filter-secteur" class="appearance-none bg-brand-paper border-2 border-brand-ink rounded-full px-4 py-1.5 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-brand-ink cursor-pointer hover:bg-brand-orange hover:text-brand-ink transition-colors">
    <option value="all">Tous secteurs</option>
    <option value="Santé">Santé</option>
    <option value="Retail">Retail</option>
    <option value="Recherche publique">Recherche publique</option>
    <option value="Public">Public</option>
  </select>
  <select id="filter-statut" class="appearance-none bg-brand-paper border-2 border-brand-ink rounded-full px-4 py-1.5 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-brand-ink cursor-pointer hover:bg-brand-orange hover:text-brand-ink transition-colors">
    <option value="all">Tous statuts</option>
    <option value="Revendiquée">Revendiquée</option>
    <option value="Confirmée">Confirmée</option>
  </select>
  <button id="filter-reset" type="button" class="text-sm font-display underline decoration-2 hover:text-brand-orange ml-auto">Réinitialiser</button>
</div>

<div id="leaks-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-2 gap-6 mb-12">
  {isEmptyCatalog && (
    <div class="col-span-full bg-brand-cream border-2 border-dashed border-brand-ink rounded-passoire p-8 sm:p-12 text-center">
      <h3 class="font-display font-extrabold text-2xl mb-2">Catalogue en préparation</h3>
      <p class="font-body text-brand-ink/70 max-w-xl mx-auto leading-relaxed">
        Aucune fiche n'est publiée pour l'instant : les premières fuites recensées arriveront
        une fois passées par notre vérification en 4 étapes. Aucune donnée inventée ici.
      </p>
      <a href="/methode/" class="inline-block mt-4 font-mono text-sm font-bold underline hover:text-brand-orange">→ comprendre la méthode de vérification</a>
    </div>
  )}
</div>

<script define:vars={{ items }}>
  const grid = document.getElementById('leaks-grid');
  const filterSecteur = document.getElementById('filter-secteur');
  const filterStatut = document.getElementById('filter-statut');
  const resetButton = document.getElementById('filter-reset');
  if (grid && filterSecteur && filterStatut && resetButton) {
    const prepState = () => {
      const prep = document.createElement('div');
      prep.className = 'col-span-full bg-brand-cream border-2 border-dashed border-brand-ink rounded-passoire p-8 sm:p-12 text-center';
      const h3 = document.createElement('h3');
      h3.className = 'font-display font-extrabold text-2xl mb-2';
      h3.textContent = 'Catalogue en préparation';
      const p = document.createElement('p');
      p.className = 'font-body text-brand-ink/70 max-w-xl mx-auto leading-relaxed';
      p.textContent = "Aucune fiche n'est publiée pour l'instant : les premières fuites recensées arriveront une fois passées par notre vérification en 4 étapes. Aucune donnée inventée ici.";
      const a = document.createElement('a');
      a.href = '/methode/';
      a.className = 'inline-block mt-4 font-mono text-sm font-bold underline hover:text-brand-orange';
      a.textContent = '→ comprendre la méthode de vérification';
      prep.append(h3, p, a);
      return prep;
    };

    const noMatchState = () => {
      const d = document.createElement('div');
      d.className = 'col-span-full py-12 text-center font-display text-xl text-brand-ink/50';
      d.textContent = 'Aucune fuite ne correspond à ces critères (heureusement).';
      return d;
    };

    const card = (leak) => {
      const isConfirm = leak.status === 'Confirmée';
      const el = document.createElement('article');
      el.className = 'bg-brand-cream border-2 border-brand-ink rounded-passoire shadow-hard p-6 flex flex-col justify-between h-full cursor-default opacity-90 transition-all';
      el.innerHTML = `
        <div>
          <div class="flex justify-between items-start mb-4">
            <span class="font-mono text-sm font-bold border-b-2 border-brand-ink pb-1 inline-block"></span>
            <span class="text-sm font-mono text-brand-ink/60"></span>
          </div>
          <h3 class="font-display font-extrabold text-2xl mb-2 line-clamp-2"></h3>
          <p class="font-mono text-lg text-brand-orange drop-shadow-[1px_1px_0px_rgba(36,20,5,1)] font-bold mb-6"></p>
        </div>
        <div class="flex justify-between items-end mt-auto">
          <span class="${isConfirm ? 'pill-confirmee' : 'pill-revendiquee'} px-3 py-1 rounded-full font-display font-bold text-sm shadow-sm flex items-center gap-1.5 w-max">${isConfirm ? 'Confirmée' : 'Revendiquée'}</span>
        </div>`;
      el.querySelector('span.font-mono.text-sm.font-bold').textContent = leak.sector;
      el.querySelector('.text-brand-ink\\/60').textContent = leak.time;
      el.querySelector('h3').textContent = leak.name;
      el.querySelector('p.font-mono.text-lg').textContent = leak.size;
      return el;
    };

    const render = (data) => {
      grid.replaceChildren();
      if (items.length === 0) {
        grid.append(prepState());
        return;
      }
      if (data.length === 0) {
        grid.append(noMatchState());
        return;
      }
      data.forEach((leak) => grid.append(card(leak)));
    };

    const applyFilters = () => {
      const sVal = filterSecteur.value;
      const stVal = filterStatut.value;
      render(items.filter((leak) =>
        (sVal === 'all' || leak.sector === sVal) && (stVal === 'all' || leak.status === stVal)
      ));
    };

    filterSecteur.addEventListener('change', applyFilters);
    filterStatut.addEventListener('change', applyFilters);
    resetButton.addEventListener('click', () => {
      filterSecteur.value = 'all';
      filterStatut.value = 'all';
      render(items);
    });
  }
</script>
