---
import Logo from './Logo.astro';
---
<footer class="bg-brand-ink text-brand-cream border-t-2 border-brand-ink mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col md:flex-row justify-between items-center gap-8">
      <!-- Wordmark sur pastille crème : la passoire ressort du fond encre -->
      <a href="/" class="bg-brand-cream border-2 border-brand-ink rounded-passoire px-4 py-2.5 flex items-center gap-2.5 font-display font-bold text-xl text-brand-ink shadow-[4px_4px_0px_0px_rgba(255,246,234,0.25)] hover:-translate-y-0.5 transition-transform focus-visible:outline-brand-cream">
        <Logo size={38} />
        FRANCEPASSOIRE
      </a>
      <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2 font-mono text-sm font-bold md:flex-1 md:justify-center" aria-label="Pied de page">
        <a href="/signaler/" class="hover:text-brand-orange hover:underline underline-offset-4 decoration-2 focus-visible:outline-brand-cream">Signaler une fuite</a>
        <a href="/mentions-legales/" class="hover:text-brand-orange hover:underline underline-offset-4 decoration-2 focus-visible:outline-brand-cream">Mentions légales</a>
        <a href="/confidentialite/" class="hover:text-brand-orange hover:underline underline-offset-4 decoration-2 focus-visible:outline-brand-cream">Confidentialité</a>
        <a href="/feed.xml" class="hover:text-brand-orange hover:underline underline-offset-4 decoration-2 focus-visible:outline-brand-cream">Flux RSS</a>
        <a href="/methode/" class="hover:text-brand-orange hover:underline underline-offset-4 decoration-2 focus-visible:outline-brand-cream">La méthode</a>
      </nav>
      <a href="https://github.com/aloyopenclaw/francepassoire.com" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-sm opacity-50 font-body whitespace-nowrap hover:opacity-100 hover:text-brand-orange transition-colors focus-visible:outline-brand-cream" aria-label="Code source sur GitHub (nouvel onglet)">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        Projet civique indépendant.
      </a>
    </div>
  </div>
</footer>
