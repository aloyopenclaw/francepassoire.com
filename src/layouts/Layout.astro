---
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Description dédiée aux réseaux (og:/twitter:) — peut différer de la
   *  meta « recherche » : social = accroche, meta = résumé SEO (owner 23/08). */
  socialDescription?: string;
  /** Canonical explicite (pages d'erreur : pointer vers « / » plutôt qu'une URL hors index). */
  canonical?: string;
  /** Image de partage (chemin site-absolu) — défaut : og-image.jpg générique (2048²). */
  image?: string;
  /** Largeur/réelles de l'image de partage (indices og:image:width/height). */
  imageWidth?: number;
  imageHeight?: number;
  /** Texte alternatif de l'image de partage (défaut : alt générique du site). */
  imageAlt?: string;
}

const {
  title,
  description = 'L\'observatoire citoyen des fuites de données en France. Fiches vérifiées, suivi ransomware et guides pratiques. Pas de panique. Mais agissons.',
  socialDescription = 'La France est une passoire à données, on compte les trous. Suivez les fuites en direct et découvrez comment protéger vos comptes.',
  canonical,
  image = '/og-image.jpg',
  imageWidth = 2048,
  imageHeight = 2048,
  imageAlt = 'FrancePassoire : observatoire citoyen des fuites de données en France',
} = Astro.props;

const canonicalURL = canonical ? new URL(canonical, Astro.site) : new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="FrancePassoire" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={imageURL} />
    <slot name="head" />
  </head>
  <body class="font-body min-h-screen flex flex-col">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
